          "~/.pi/agent/npm/node_modules/@gotgenes/pi-permission-system",
          "~/.pi/agent/npm/node_modules/@ff-labs/pi-fff",
          "~/.pi/agent/npm/node_modules/pi-web-access"
        ],
        "inheritGlobalContext": true,
        "tools": [
          "read",
          "grep",
          "multi_grep",
          "find",
